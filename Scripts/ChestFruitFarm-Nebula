-- Chest & Fruit Farm - Nebula UI Edition v6.0 (Full Feature)
-- Features: Auto Fruit Collect, Chest Farm, ESPs, Serverhop, Team Join

if not game:IsLoaded() then game.Loaded:Wait() end

-- =====================================================
--  NEBULA UI LADEN
-- =====================================================
local Nebula
local success, err = pcall(function()
    Nebula = loadstring(game:HttpGet("https://raw.githubusercontent.com/lzwdev/Nebula/refs/heads/main/Nebula-UI/V3.lua"))()
end)
if not success or not Nebula then
    warn("Nebula UI konnte nicht geladen werden: " .. tostring(err))
    return
end

-- =====================================================
--  SERVICES
-- =====================================================
local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local CoreGui          = game:GetService("CoreGui")
local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CollectionService= game:GetService("CollectionService")
local ReplicatedStorage= game:GetService("ReplicatedStorage")
local LocalPlayer      = Players.LocalPlayer

-- =====================================================
--  VARIABLEN & STATE
-- =====================================================
local State = {
    FruitESP     = false,
    AutoTween    = false,
    AutoFruit    = false,
    TweenSpeed   = 220,
    
    ChestESP     = false,
    ChestFarm    = false,
    
    AutoServerhop = false,
    ServerhopTarget = 100,
    
    KnownFruits  = {}
}

-- WICHTIG: Das hier verhindert, dass sich Chest Farm und Fruit Tween gegenseitig unterbrechen!
local isBusy = false 
local chestESPObjects = {}
local ignoredChests = {}
local currentChestTarget = nil
local chestArrivedTime = 0
local chestsCollected = 0
local lastServerhopTime = 0
local BLOX_FRUITS_PLACE_ID = 2753915549

-- =====================================================
--  HELPER: Section erstellen (mit Fallbacks)
-- =====================================================
local function CreateSection(tab, name)
    local ok, res = pcall(function() return tab:CreateSection(name) end)
    if ok and res then return res end
    ok, res = pcall(function() return tab:CreateSection({ Name = name }) end)
    if ok and res then return res end
    ok, res = pcall(function() return Nebula.CreateSection(tab, { Name = name }) end)
    if ok and res then return res end
    ok, res = pcall(function() return Nebula.CreateSection(tab, name) end)
    if ok and res then return res end
    return nil
end

local function getRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getChests()
    local list = {}
    for _, ch in pairs(CollectionService:GetTagged("_ChestTagged")) do
        if ch and ch:IsA("BasePart") and not ch:GetAttribute("IsDisabled") then
            table.insert(list, ch)
        end
    end
    return list
end

local function getFruits()
    local list = {}
    for _, obj in pairs(workspace:GetChildren()) do
        if obj and obj:FindFirstChild("Handle") then
            local h = obj.Handle
            if h and h:IsA("BasePart") and (string.find(obj.Name, "Fruit") or string.find(obj.Name:lower(), "fruit")) then
                table.insert(list, obj)
            end
        end
    end
    return list
end

-- =====================================================
--  NEBULA UI AUFBAU
-- =====================================================
local Window = Nebula.CreateWindow({
    Title = "Chest & Fruit Farm v6.0",
    ConfigName = "ChestFruitFarm_Nebula",
    ShowLoading = true,
    LoadingDuration = 2,
    LoadingSteps = { "Initializing...", "Loading UI...", "Ready!" }
})

local MainTab     = Window:CreateTab("Main", "🎯")
local FruitTab    = Window:CreateTab("Fruits", "🍎")
local ServerTab   = Window:CreateTab("Server", "🔄")
local SettingsTab = Window:CreateTab("Settings", "⚙")

-- MAIN TAB (Chest Farm)
local MainSec = CreateSection(MainTab, "Chest Farm")
if MainSec then
    MainSec:CreateToggle({ Name = "Auto Chest Farm", Default = false, Callback = function(v) 
        State.ChestFarm = v 
        if v then ignoredChests = {}; currentChestTarget = nil end
    end })
    MainSec:CreateToggle({ Name = "Chest ESP", Default = false, Callback = function(v) 
        State.ChestESP = v 
        if not v then for ch, d in pairs(chestESPObjects) do if d.BB then d.BB:Destroy() end; chestESPObjects[ch] = nil end end
    end })
end

-- FRUIT TAB
local FruitSec = CreateSection(FruitTab, "Fruit Farm")
if FruitSec then
    FruitSec:CreateToggle({ Name = "Auto Collect Fruit (Tween)", Default = false, Callback = function(v) State.AutoFruit = v end })
    FruitSec:CreateToggle({ Name = "Fruit ESP", Default = false, Callback = function(v) State.FruitESP = v end })
    FruitSec:CreateToggle({ Name = "Auto Tween (Speed Slider)", Default = false, Callback = function(v) State.AutoTween = v end })
    FruitSec:CreateSlider({ Name = "Tween Speed", Min = 50, Max = 300, Default = 220, Suffix = " studs/s", Callback = function(v) State.TweenSpeed = v end })
end

-- SERVER TAB
local ServerSec = CreateSection(ServerTab, "Server Hop")
if ServerSec then
    ServerSec:CreateToggle({ Name = "Auto Serverhop", Default = false, Callback = function(v) State.AutoServerhop = v end })
    ServerSec:CreateSlider({ Name = "Hop at Chest Count", Min = 10, Max = 500, Default = 100, Callback = function(v) State.ServerhopTarget = v end })
    ServerSec:CreateButton({ Name = "Serverhop NOW", Callback = function() 
        pcall(function() TeleportService:Teleport(BLOX_FRUITS_PLACE_ID, LocalPlayer) end) 
    end })
end

-- SETTINGS TAB
local SetSec = CreateSection(SettingsTab, "Allgemein")
if SetSec then
    SetSec:CreateToggle({ Name = "Noclip", Default = false, Callback = function(Value)
        local function setNoclip(c, state)
            if not c then return end
            pcall(function()
                for _, p in pairs(c:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = not state end
                end
            end)
        end
        if Value then
            LocalPlayer.CharacterAdded:Connect(function(c) task.wait(0.1); setNoclip(c, true) end)
            if LocalPlayer.Character then setNoclip(LocalPlayer.Character, true) end
        else
            if LocalPlayer.Character then setNoclip(LocalPlayer.Character, false) end
        end
    end })
    
    SetSec:CreateButton({ Name = "Join Marines", Callback = function() 
        pcall(function() ReplicatedStorage.Remotes.CommF_:InvokeServer("SetTeam", "Marines") end) 
    end })
    
    SetSec:CreateButton({ Name = "Join Pirates", Callback = function() 
        pcall(function() ReplicatedStorage.Remotes.CommF_:InvokeServer("SetTeam", "Pirates") end) 
    end })
end

-- =====================================================
--  BACKGROUND LOOPS (Sicher & Stabil)
-- =====================================================

-- 1. CHEST ESP LOOP
task.spawn(function()
    while task.wait(0.3) do
        if not State.ChestESP then continue end
        pcall(function()
            local root = getRoot()
            if not root then return end
            for _, ch in pairs(getChests()) do
                if not chestESPObjects[ch] then
                    local bb = Instance.new("BillboardGui")
                    bb.Size = UDim2.new(0, 160, 0, 30); bb.Adornee = ch; bb.AlwaysOnTop = true; bb.Parent = ch
                    local bg = Instance.new("Frame")
                    bg.Size = UDim2.new(1,0,1,0); bg.BackgroundColor3 = Color3.new(0,0,0); bg.BackgroundTransparency = 0.5; bg.Parent = bb
                    local l = Instance.new("TextLabel")
                    l.Size = UDim2.new(1,0,1,0); l.BackgroundTransparency = 1; l.TextColor3 = Color3.fromRGB(255,215,0); l.TextScaled = true; l.Font = Enum.Font.GothamBold; l.Parent = bb
                    chestESPObjects[ch] = { BB = bb, Lbl = l }
                end
                local d = math.floor((root.Position - ch:GetPivot().Position).Magnitude / 3 + 0.5)
                chestESPObjects[ch].Lbl.Text = "Chest (" .. d .. "m)"
            end
        end)
    end
end)

-- 2. CHEST FARM LOOP (Tween repariert mit isBusy)
task.spawn(function()
    while task.wait(0.5) do
        if not State.ChestFarm or isBusy then continue end
        pcall(function()
            local root = getRoot()
            if not root then return end
            
            -- Auto Serverhop Prüfung
            if State.AutoServerhop and chestsCollected >= State.ServerhopTarget and tick() - lastServerhopTime > 30 then
                lastServerhopTime = tick(); pcall(function() TeleportService:Teleport(BLOX_FRUITS_PLACE_ID, LocalPlayer) end); return
            end

            local best, bestD = nil, math.huge
            for _, c in ipairs(getChests()) do
                if not ignoredChests[c] then
                    local d = (c:GetPivot().Position - root.Position).Magnitude
                    if d < bestD then bestD = d; best = c end
                end
            end

            if best then
                isBusy = true -- SPERRT den Tween für andere Skripte
                local dist = (best:GetPivot().Position - root.Position).Magnitude
                local duration = math.max(0.1, dist / State.TweenSpeed)
                local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = best:GetPivot().Position + Vector3.new(0,3,0) })
                tween:Play()
                tween.Completed:Wait()
                chestsCollected = chestsCollected + 1
                isBusy = false
            end
        end)
    end
end)

-- 3. FRUIT TWEEN & AUTO COLLECT LOOP
task.spawn(function()
    while task.wait(0.5) do
        if isBusy then continue end -- Überspringen, wenn Chest Farm gerade aktiv ist
        pcall(function()
            local root = getRoot()
            if not root then return end

            -- Auto Collect Fruit (Teleport & Sammeln)
            if State.AutoFruit then
                local fruits = getFruits()
                for _, fruit in ipairs(fruits) do
                    if fruit and fruit:FindFirstChild("Handle") then
                        isBusy = true
                        local dist = (fruit.Handle.Position - root.Position).Magnitude
                        local duration = math.max(0.1, dist / State.TweenSpeed)
                        local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = CFrame.new(fruit.Handle.Position - Vector3.new(0,5,0)) })
                        tween:Play()
                        tween.Completed:Wait()
                        task.wait(0.3)
                        
                        local name = string.gsub(fruit.Name, " Fruit", "")
                        pcall(function() ReplicatedStorage.Remotes.CommF_:InvokeServer("StoreFruit", name .. "-" .. name, LocalPlayer.Character:FindFirstChildOfClass("Tool")) end)
                        isBusy = false
                        break
                    end
                end
            end

            -- Auto Tween (nur hinfliegen, nicht einsammeln)
            if State.AutoTween and not State.ChestFarm and not State.AutoFruit then
                local fruits = getFruits()
                if #fruits > 0 then
                    isBusy = true
                    local target = fruits[1].Handle
                    local dist = (target.Position - root.Position).Magnitude
                    local duration = math.max(0.1, dist / State.TweenSpeed)
                    local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = CFrame.new(target.Position) })
                    tween:Play()
                    tween.Completed:Wait()
                    isBusy = false
                end
            end
        end)
    end
end)

Window:Notify({ Title = "Geladen!", Content = "Chest & Fruit Farm v6.0", Type = "success", Duration = 5 })
print("✅ v6.0 erfolgreich geladen!")
